# Copia a .env y ajusta.
CHESSCOM_USERNAME=tu_usuario
# chess.com exige un User-Agent identificable (con contacto) en su API pública.
# "LUCIA/0.1" es el nombre/versión de la app, no lo cambies por tu nick; lo
# que sí debes cambiar es el contacto (un correo real donde puedan avisarte
# si tus peticiones causan problemas). Un User-Agent genérico hace que
# ChessComClient falle al arrancar, a propósito.
CHESSCOM_USER_AGENT="LUCIA/0.1 (contacto: tu@email.com)"

# Token del Opening Explorer de Lichess, lo único que LUCIA consulta por red
# mientras se usa (RF-3.6, ADR-0010). Es OBLIGATORIO para esa pantalla: el
# explorador responde 401 a cualquier petición anónima. Es gratuito y no
# necesita permisos: https://lichess.org/account/oauth/token
LICHESS_TOKEN=""
# Con qué se identifica LUCIA ante Lichess. Vacío usa el de chess.com, que ya
# lleva contacto real.
LICHESS_USER_AGENT=""
# Espera mínima entre consultas al explorador, en segundos. Es un servicio
# gratuito y aquí se le pregunta por muchas posiciones seguidas.
EXPLORER_MIN_INTERVAL_SECONDS=1.0

DATABASE_URL=sqlite+aiosqlite:///./data/lucia.db

STOCKFISH_PATH=./engines/bin/stockfish
LC0_PATH=./engines/bin/lc0
# Red de Lc0. Medido en una GTX 1060 (200 nodos sobre la posición inicial):
#   744706-conv.pb.gz  ~4.000 nodos/s por OpenCL. Recomendada: fuerte y
#                      compatible con OpenCL, que no acepta redes transformer.
#   maia-1500.pb.gz    ~12.500 nodos/s, pero imita a un humano de ~1500; para
#                      sparring, no para análisis objetivo.
#   default.pb.gz      la más fuerte, pero es transformer: OpenCL la rechaza y
#                      en CPU tarda 80 s por cada 200 nodos. Necesita CUDA.
LC0_WEIGHTS=./engines/networks/744706-conv.pb.gz
# Backend de Lc0. Déjalo vacío salvo que sepas más que Lc0 sobre tu máquina:
# vacío no lo deja sin backend, deja que elija entre los que el instalador
# compiló (CUDA si había nvcc, si no OpenCL, si no CPU), y elige bien. Medido
# con la red T74, 3.000 nodos, en una GTX 1060: vacío 1,23 s, "opencl" 1,12 s,
# "blas" 14,88 s. Forzar uno que no se compiló es un error duro al arrancar.
LC0_BACKEND=
# Red con la que Lc0 hace de rival en el sparring (RF-4.3), aparte de la de
# análisis: Maia no busca la mejor jugada, predice la que haría una persona de
# ese nivel, así que es buen rival y mala fuente de verdad. La familia va de
# maia-1100 a maia-1900; cambiarla es cambiar la fuerza del rival de Lc0.
MAIA_WEIGHTS=./engines/networks/maia-1500.pb.gz

# Profundidad / tiempo por defecto del análisis
ANALYSIS_DEPTH=18
ANALYSIS_MULTIPV=3
