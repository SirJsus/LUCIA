# Copia a .env y ajusta.
CHESSCOM_USERNAME=tu_usuario
# chess.com exige un User-Agent identificable (con contacto) en su API pública.
# "LUCIA/0.1" es el nombre/versión de la app, no lo cambies por tu nick; lo
# que sí debes cambiar es el contacto (un correo real donde puedan avisarte
# si tus peticiones causan problemas). Un User-Agent genérico hace que
# ChessComClient falle al arrancar, a propósito.
CHESSCOM_USER_AGENT="LUCIA/0.1 (contacto: tu@email.com)"

DATABASE_URL=sqlite+aiosqlite:///./data/lucia.db

STOCKFISH_PATH=./engines/bin/stockfish
LC0_PATH=./engines/bin/lc0
# Red de Lc0. Medido en una GTX 1060 (200 nodos sobre la posición inicial):
#   744706-conv.pb.gz  ~4.000 nodos/s por OpenCL. Recomendada: fuerte y
#                      compatible con OpenCL, que no acepta redes transformer.
#   maia-1500.pb.gz    ~12.500 nodos/s, pero imita a un humano de ~1500; para
#                      sparring, no para análisis objetivo.
#   default.pb.gz      la más fuerte, pero es transformer: OpenCL la rechaza y
#                      en CPU tarda 80 s por cada 200 nodos. Necesita CUDA.
LC0_WEIGHTS=./engines/networks/744706-conv.pb.gz
# Backend de Lc0: "opencl" o "cuda" con GPU, "blas" en CPU. Sin esto Lc0 elige
# por su cuenta y puede ser ~20x más lento.
LC0_BACKEND=opencl

# Profundidad / tiempo por defecto del análisis
ANALYSIS_DEPTH=18
ANALYSIS_MULTIPV=3
