  "components": {
    "schemas": {
      "AnalysisDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "game_id": {
            "type": "integer",
            "title": "Game Id"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "depth": {
            "type": "integer",
            "title": "Depth"
          },
          "multipv": {
            "type": "integer",
            "title": "Multipv"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "white_accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "White Accuracy"
          },
          "black_accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Black Accuracy"
          },
          "moves": {
            "items": {
              "$ref": "#/components/schemas/AnalyzedMoveOut"
            },
            "type": "array",
            "title": "Moves"
          }
        },
        "type": "object",
        "required": [
          "id",
          "game_id",
          "engine",
          "depth",
          "multipv",
          "status",
          "error",
          "white_accuracy",
          "black_accuracy",
          "moves"
        ],
        "title": "AnalysisDetail"
      },
      "AnalysisRequest": {
        "properties": {
          "game_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Game Ids"
          },
          "engine": {
            "type": "string",
            "enum": [
              "stockfish",
              "lc0"
            ],
            "title": "Engine",
            "default": "stockfish"
          },
          "depth": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Depth"
          },
          "multipv": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Multipv"
          }
        },
        "type": "object",
        "required": [
          "game_ids"
        ],
        "title": "AnalysisRequest"
      },
      "AnalysisSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "game_id": {
            "type": "integer",
            "title": "Game Id"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "depth": {
            "type": "integer",
            "title": "Depth"
          },
          "multipv": {
            "type": "integer",
            "title": "Multipv"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "white_accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "White Accuracy"
          },
          "black_accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Black Accuracy"
          }
        },
        "type": "object",
        "required": [
          "id",
          "game_id",
          "engine",
          "depth",
          "multipv",
          "status",
          "error",
          "white_accuracy",
          "black_accuracy"
        ],
        "title": "AnalysisSummary"
      },
      "AnalyzedMoveOut": {
        "properties": {
          "ply": {
            "type": "integer",
            "title": "Ply"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "san": {
            "type": "string",
            "title": "San"
          },
          "uci": {
            "type": "string",
            "title": "Uci"
          },
          "fen_before": {
            "type": "string",
            "title": "Fen Before"
          },
          "classification": {
            "type": "string",
            "title": "Classification"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "move_accuracy": {
            "type": "number",
            "title": "Move Accuracy"
          },
          "win_percent_before": {
            "type": "number",
            "title": "Win Percent Before"
          },
          "win_percent_after": {
            "type": "number",
            "title": "Win Percent After"
          },
          "best_move_uci": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Best Move Uci"
          }
        },
        "type": "object",
        "required": [
          "ply",
          "color",
          "san",
          "uci",
          "fen_before",
          "classification",
          "phase",
          "move_accuracy",
          "win_percent_before",
          "win_percent_after",
          "best_move_uci"
        ],
        "title": "AnalyzedMoveOut"
      },
      "BoardCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "root_fen": {
            "type": "string",
            "title": "Root Fen",
            "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
          },
          "tree_json": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tree Json"
          },
          "tags_json": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags Json"
          },
          "is_own_game": {
            "type": "boolean",
            "title": "Is Own Game",
